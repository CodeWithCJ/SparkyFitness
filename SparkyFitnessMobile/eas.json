{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": {
        "APP_VARIANT": "development"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "env": {
        "APP_VARIANT": "preview"
      },
      "distribution": "internal"
    },
    "production": {
      "env": {
        "APP_VARIANT": "production"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "medium",
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "wearos": {
      "extends": "production",
      "autoIncrement": false,
      "android": {
        "gradleCommand": ":wearos:bundleRelease",
        "applicationArchivePath": "android/wearos/build/outputs/bundle/release/*.aab"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "alpha"
      },
      "ios": {
        "ascAppId": "6757314392"
      }
    },
    "wearos": {
      "android": {
        "track": "wear:alpha"
      }
    }
  }
}
