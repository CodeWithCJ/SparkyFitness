<?xml version="1.0" encoding="utf-8"?>
<!--
  Macro widget initial/preview layout. Mirrors the classic Glance layout
  (22415819): one-line localized kcal header followed by three inline macro
  rows (colored dot + label + value with a progress bar underneath) in the
  classic 2x2 footprint. No action row at the default footprint.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="#FFFFFFFF"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_macros_left"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FF1F1F1F"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#FFF6B151"
                    android:text="" />

                <TextView
                    android:layout_width="6dp"
                    android:layout_height="1dp"
                    android:text="" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_protein"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FF1F1F1F"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_grams_protein"
                    android:textSize="12sp"
                    android:textColor="#FF5F5F5F"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:background="#FFE2E4EB">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="match_parent"
                    android:background="#FFF6B151"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#FF7BD680"
                    android:text="" />

                <TextView
                    android:layout_width="6dp"
                    android:layout_height="1dp"
                    android:text="" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_carbs"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FF1F1F1F"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_grams_carbs"
                    android:textSize="12sp"
                    android:textColor="#FF5F5F5F"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:background="#FFE2E4EB">

                <TextView
                    android:layout_width="136dp"
                    android:layout_height="match_parent"
                    android:background="#FF7BD680"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="#FF6DCBE9"
                    android:text="" />

                <TextView
                    android:layout_width="6dp"
                    android:layout_height="1dp"
                    android:text="" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_fat"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FF1F1F1F"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_grams_fat"
                    android:textSize="12sp"
                    android:textColor="#FF5F5F5F"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:background="#FFE2E4EB">

                <TextView
                    android:layout_width="78dp"
                    android:layout_height="match_parent"
                    android:background="#FF6DCBE9"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
