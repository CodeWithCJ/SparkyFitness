<?xml version="1.0" encoding="utf-8"?>
<!--
  Macro widget initial/preview layout. Mirrors the compact Glance layout:
  the kcal header and each macro row stack the label above the value so
  "Węglowodany" is never truncated to fit beside its gram value in the widget
  picker preview.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="#FFFFFFFF"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_kcal_left_caption"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FF5F5F5F"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_macros_value"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FF1F1F1F"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#FFF6B151"
                android:text="" />

            <TextView
                android:layout_width="6dp"
                android:layout_height="1dp"
                android:text="" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_protein"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF1F1F1F"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="16dp"
                android:layout_height="1dp"
                android:text="" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_grams_protein"
                android:textSize="13sp"
                android:textColor="#FF5F5F5F"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:background="#FFE2E4EB">

            <TextView
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:background="#FFF6B151"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#FF7BD680"
                android:text="" />

            <TextView
                android:layout_width="6dp"
                android:layout_height="1dp"
                android:text="" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_carbs"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF1F1F1F"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="16dp"
                android:layout_height="1dp"
                android:text="" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_grams_carbs"
                android:textSize="13sp"
                android:textColor="#FF5F5F5F"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:background="#FFE2E4EB">

            <TextView
                android:layout_width="154dp"
                android:layout_height="match_parent"
                android:background="#FF7BD680"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#FF6DCBE9"
                android:text="" />

            <TextView
                android:layout_width="6dp"
                android:layout_height="1dp"
                android:text="" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_fat"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF1F1F1F"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="16dp"
                android:layout_height="1dp"
                android:text="" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_grams_fat"
                android:textSize="13sp"
                android:textColor="#FF5F5F5F"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:background="#FFE2E4EB">

            <TextView
                android:layout_width="78dp"
                android:layout_height="match_parent"
                android:background="#FF6DCBE9"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_search"
            android:tint="#FF3B82F6"
            android:contentDescription="@string/widget_search_food" />

        <TextView
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:background="#FFE2E4EB"
            android:text="" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_scan"
            android:tint="#FF3B82F6"
            android:contentDescription="@string/widget_scan_barcode" />
    </LinearLayout>
</LinearLayout>
