package com.sparkyapps.sparkyfitness.widget

import android.app.LocaleManager
import android.content.Context
import android.content.res.Configuration
import android.os.Build
import java.text.NumberFormat
import java.util.Locale

/**
 * Widget-only locale override, kept in a dedicated SharedPreferences namespace
 * on purpose — it never touches the RN app preference persistence format.
 *
 * Platform contract:
 *   Android 13+ (API 33+): the platform per-app language
 *   (android.app.LocaleManager / applicationLocales, final PR3) is the
 *   authoritative source of the app language. A widget-only override is NEVER
 *   applied here and any stale value persisted by an older OS/install is
 *   cleared on write. On every render we read the CURRENT locale straight from
 *   LocaleManager and build a local ConfigurationContext. This is what makes a
 *   language change (in-app via LocaleManager, or out-of-app via Android
 *   Settings / HyperOS App language) win even while the app process is alive —
 *   the process Context may not have processed the configuration change yet,
 *   so we never trust reactApplicationContext.resources.configuration on
 *   API 33+; we resolve LocaleManager.applicationLocales (falling back to the
 *   system locale when empty) instead.
 *   Android 12 and below (API <=32): the explicit app language is local to the
 *   RN app (i18next/Zustand), so Android resources would NOT follow it
 *   automatically. The override lets the widgets render in the app-selected
 *   language without reintroducing AppCompat and without calling the PR3
 *   native app-language module.
 *
 * Semantics:
 *   "en"    -> force English widget resources (API <=32 only)
 *   "pl"    -> force Polish widget resources (API <=32 only)
 *   absent  -> follow the system/native resource locale
 *
 * On API 33+ every request (en / pl / system) clears the widget override: the
 * actual locale is already controlled by LocaleManager, so native App Language
 * state is never duplicated into widget SharedPreferences.
 */
object WidgetLocale {

    private const val PREFS_NAME = "SparkyWidgetLocale"
    private const val KEY_LOCALE = "widgetLocale"

    private fun isNativeAppLanguageSupported(): Boolean =
        Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU

    /**
     * Current override ("en"/"pl") or null when the widget follows the system.
     * Never returns an override on Android 13+: the native LocaleManager is
     * authoritative, so a stale <=12 preference is harmless after an OS
     * upgrade.
     */
    fun override(context: Context): Locale? {
        if (isNativeAppLanguageSupported()) return null
        val code = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
            .getString(KEY_LOCALE, null)
        return when (code) {
            "en" -> Locale.forLanguageTag("en")
            "pl" -> Locale.forLanguageTag("pl")
            else -> null
        }
    }

    /**
     * Persists ("en"/"pl") or removes (null) the widget override on API <=32.
     * On API 33+ the request clears any stale override instead of persisting:
     * the native LocaleManager already controls the app language, and
     * duplicating it in widget SharedPreferences could leave a widget stuck in
     * an old language after an out-of-app App Language change. Rejects any
     * other value so the bridge can never persist an unknown locale.
     */
    fun setOverride(context: Context, locale: String?) {
        val normalized = locale?.trim()?.lowercase(Locale.ROOT)?.ifEmpty { null }
        if (normalized != null && normalized !in SUPPORTED_LOCALES) {
            throw IllegalArgumentException("Only en, pl, or null are supported")
        }
        val editor = context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
            .edit()
        if (isNativeAppLanguageSupported() || normalized == null) {
            editor.remove(KEY_LOCALE)
        } else {
            editor.putString(KEY_LOCALE, normalized)
        }
        if (!editor.commit()) {
            throw IllegalStateException("Failed to persist widget locale override")
        }
    }

    /**
     * Current locale for widget resources on this render. On API 33+ this is
     * the LocaleManager application locale (or system locale when empty), read
     * fresh every render — never the possibly-stale process Context locale,
     * which may not have processed the configuration change yet while the app
     * is alive.
     */
    private fun nativeEffectiveLocale(context: Context): Locale? {
        val manager = context.getSystemService(LocaleManager::class.java) ?: return null
        val appLocales = manager.applicationLocales
        if (appLocales != null && !appLocales.isEmpty) {
            return appLocales[0]
        }
        val systemLocales = manager.systemLocales
        if (systemLocales != null && !systemLocales.isEmpty) {
            return systemLocales[0]
        }
        return null
    }

    /**
     * Returns a Context whose resources and number formatting resolve in the
     * override locale on API <=32, or in the LocaleManager-resolved locale on
     * API 33+. On API 33+ the locale is read fresh from LocaleManager each
     * render (application locale, else system locale, else the process
     * configuration), so the widget language follows the platform immediately
     * — in-app and out-of-app — without restarting the app. The override is
     * strictly local to widget rendering: it never mutates the global locale,
     * the system resources singleton, or the app process configuration.
     */
    fun localizedContext(context: Context): Context {
        val locale = if (isNativeAppLanguageSupported()) {
            nativeEffectiveLocale(context) ?: return context
        } else {
            override(context) ?: return context
        }
        val config = Configuration(context.resources.configuration)
        config.setLocale(locale)
        return context.createConfigurationContext(config)
    }

    private val SUPPORTED_LOCALES = setOf("en", "pl")
}

/**
 * Locale-aware integer formatting shared by every widget surface. Both widgets
 * render the same values (e.g. remaining calories), so one rounding rule keeps
 * them consistent on the home screen.
 */
fun currentWidgetLocale(context: Context): Locale {
    val locales = context.resources.configuration.locales
    return if (locales.isEmpty) Locale.getDefault() else locales[0]
}

fun formatWidgetInt(context: Context, value: Long): String {
    // Formatting only — locale-aware grouping/separators. Business rounding
    // stays with each caller (Calorie truncates, Macro rounds), preserving the
    // pre-localization behavior.
    return NumberFormat.getIntegerInstance(currentWidgetLocale(context)).format(value)
}
