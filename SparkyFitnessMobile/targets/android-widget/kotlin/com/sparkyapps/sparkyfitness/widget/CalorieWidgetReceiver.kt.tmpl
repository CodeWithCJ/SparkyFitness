package com.sparkyapps.sparkyfitness.widget

import android.app.AlarmManager
import android.app.PendingIntent
import android.appwidget.AppWidgetManager
import android.content.ComponentName
import android.content.Context
import android.content.Intent
import androidx.glance.appwidget.GlanceAppWidget
import androidx.glance.appwidget.GlanceAppWidgetManager
import androidx.glance.appwidget.GlanceAppWidgetReceiver
import androidx.glance.appwidget.updateAll
import java.time.LocalDate
import java.time.ZoneId
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch

class CalorieWidgetReceiver : GlanceAppWidgetReceiver() {

    override val glanceAppWidget: GlanceAppWidget = CalorieWidget()

    override fun onReceive(context: Context, intent: Intent) {
        if (intent.action == ACTION_MIDNIGHT_REFRESH) {
            val pending = goAsync()
            CoroutineScope(Dispatchers.Default).launch {
                try {
                    glanceAppWidget.updateAll(context)
                    scheduleMidnightRefresh(context)
                } finally {
                    pending.finish()
                }
            }
            return
        }
        if (intent.action == Intent.ACTION_LOCALE_CHANGED) {
            // Out-of-app language change (Android Settings App Languages, also
            // device-wide). The provider XML is registered for this broadcast
            // by the config plugin; re-render every placed instance so the
            // localized resources / WidgetLocale context refresh immediately
            // without the app foregrounding.
            val pending = goAsync()
            CoroutineScope(Dispatchers.Default).launch {
                try {
                    WidgetLocale.refreshEffectiveRenderLocaleFromBroadcast(context, intent)
                    val manager = GlanceAppWidgetManager(context)
                    manager.getGlanceIds(CalorieWidget::class.java).forEach { id ->
                        WidgetLocale.bumpLocaleRenderRevision(context, id)
                    }
                    glanceAppWidget.updateAll(context)
                } catch (e: CancellationException) {
                    throw e
                } catch (e: Exception) {
                    // A system broadcast must not crash the receiver; the next
                    // locale/snapshot refresh can retry the invalidation.
                } finally {
                    pending.finish()
                }
            }
            return
        }
        super.onReceive(context, intent)
    }

    override fun onUpdate(
        context: Context,
        appWidgetManager: AppWidgetManager,
        appWidgetIds: IntArray,
    ) {
        super.onUpdate(context, appWidgetManager, appWidgetIds)
        scheduleMidnightRefresh(context)
    }

    override fun onDisabled(context: Context) {
        super.onDisabled(context)
        cancelMidnightRefresh(context)
    }

    companion object {
        const val PREFS_NAME = "SparkyCalorieWidget"
        const val PREFS_KEY_SNAPSHOT = "calorieSnapshot"
        const val ACTION_MIDNIGHT_REFRESH =
            "com.sparkyapps.sparkyfitness.widget.ACTION_MIDNIGHT_REFRESH"
        private const val MIDNIGHT_BUFFER_MS = 1_000L

        fun scheduleMidnightRefresh(context: Context) {
            val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as? AlarmManager
                ?: return
            alarmManager.setAndAllowWhileIdle(
                AlarmManager.RTC,
                nextMidnightMillis(),
                midnightPendingIntent(context),
            )
        }

        fun cancelMidnightRefresh(context: Context) {
            val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as? AlarmManager
                ?: return
            alarmManager.cancel(midnightPendingIntent(context))
        }

        fun allWidgetIds(context: Context): IntArray {
            val manager = AppWidgetManager.getInstance(context)
            val component = ComponentName(context, CalorieWidgetReceiver::class.java)
            return manager.getAppWidgetIds(component)
        }

        private fun midnightPendingIntent(context: Context): PendingIntent {
            val intent = Intent(context, CalorieWidgetReceiver::class.java).apply {
                action = ACTION_MIDNIGHT_REFRESH
            }
            val flags = PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
            return PendingIntent.getBroadcast(context, 0, intent, flags)
        }

        private fun nextMidnightMillis(): Long {
            val zone = ZoneId.systemDefault()
            val tomorrowMidnight = LocalDate.now(zone)
                .plusDays(1)
                .atStartOfDay(zone)
                .toInstant()
                .toEpochMilli()
            return tomorrowMidnight + MIDNIGHT_BUFFER_MS
        }
    }
}
