package com.sparkyapps.sparkyfitness.widget

import android.content.Context
import androidx.glance.appwidget.GlanceAppWidgetManager
import androidx.glance.appwidget.state.updateAppWidgetState
import com.facebook.react.bridge.Promise
import com.facebook.react.bridge.ReactApplicationContext
import com.facebook.react.bridge.ReactContextBaseJavaModule
import com.facebook.react.bridge.ReactMethod
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.SupervisorJob
import kotlinx.coroutines.cancel
import kotlinx.coroutines.launch

class CalorieWidgetModule(reactContext: ReactApplicationContext) :
    ReactContextBaseJavaModule(reactContext) {

    private val moduleScope = CoroutineScope(SupervisorJob() + Dispatchers.Default)

    override fun getName(): String = NAME

    override fun invalidate() {
        moduleScope.cancel()
        super.invalidate()
    }

    @ReactMethod
    fun setCalorieSnapshot(json: String, promise: Promise) {
        val ctx = reactApplicationContext
        moduleScope.launch {
            try {
                val prefs = ctx.getSharedPreferences(
                    CalorieWidgetReceiver.PREFS_NAME,
                    Context.MODE_PRIVATE,
                )
                if (!prefs.edit().putString(CalorieWidgetReceiver.PREFS_KEY_SNAPSHOT, json).commit()) {
                    throw IllegalStateException("Failed to persist calorie widget snapshot")
                }

                val manager = GlanceAppWidgetManager(ctx)
                manager.getGlanceIds(CalorieWidget::class.java).forEach { id ->
                    updateAppWidgetState(ctx, id) { state ->
                        state[CalorieWidget.SNAPSHOT_STATE_KEY] = json
                    }
                }
                promise.resolve(null)
            } catch (e: Exception) {
                promise.reject("E_WRITE_FAILED", e)
            }
        }
    }

    @ReactMethod
    fun setMacroSnapshot(json: String, promise: Promise) {
        val ctx = reactApplicationContext
        moduleScope.launch {
            try {
                val prefs = ctx.getSharedPreferences(
                    MacroWidgetReceiver.PREFS_NAME,
                    Context.MODE_PRIVATE,
                )
                if (!prefs.edit().putString(MacroWidgetReceiver.PREFS_KEY_SNAPSHOT, json).commit()) {
                    throw IllegalStateException("Failed to persist macro widget snapshot")
                }

                val manager = GlanceAppWidgetManager(ctx)
                manager.getGlanceIds(MacroWidget::class.java).forEach { id ->
                    updateAppWidgetState(ctx, id) { state ->
                        state[MacroWidget.SNAPSHOT_STATE_KEY] = json
                    }
                }
                promise.resolve(null)
            } catch (e: Exception) {
                promise.reject("E_WRITE_FAILED", e)
            }
        }
    }

    /**
     * Persists ("en"/"pl") or removes (null) the widget-only locale override
     * used by Glance on Android <=12, where Android resources do not follow
     * the RN-local app language. Values are validated inside WidgetLocale; a
     * failed write rejects so the JS hook stays retryable.
     */
    @ReactMethod
    fun setWidgetLocale(locale: String?, promise: Promise) {
        val ctx = reactApplicationContext
        moduleScope.launch {
            try {
                WidgetLocale.setOverride(ctx, locale)
                promise.resolve(null)
            } catch (e: Exception) {
                promise.reject("E_WRITE_FAILED", e)
            }
        }
    }

    @ReactMethod
    fun reloadWidget(promise: Promise) {
        val ctx = reactApplicationContext
        moduleScope.launch {
            try {
                val manager = GlanceAppWidgetManager(ctx)
                val widget = CalorieWidget()
                var failures = 0
                manager.getGlanceIds(CalorieWidget::class.java).forEach { id ->
                    try {
                        widget.update(ctx, id)
                    } catch (ignored: Exception) {
                        failures++
                    }
                }
                if (failures > 0) {
                    promise.reject("E_RELOAD_FAILED", RuntimeException("$failures calorie widget instance(s) failed to update"))
                } else {
                    promise.resolve(null)
                }
            } catch (e: Exception) {
                promise.reject("E_RELOAD_FAILED", e)
            }
        }
    }

    @ReactMethod
    fun reloadMacroWidget(promise: Promise) {
        val ctx = reactApplicationContext
        moduleScope.launch {
            try {
                val manager = GlanceAppWidgetManager(ctx)
                val widget = MacroWidget()
                var failures = 0
                manager.getGlanceIds(MacroWidget::class.java).forEach { id ->
                    try {
                        widget.update(ctx, id)
                    } catch (ignored: Exception) {
                        failures++
                    }
                }
                if (failures > 0) {
                    promise.reject("E_RELOAD_FAILED", RuntimeException("$failures macro widget instance(s) failed to update"))
                } else {
                    promise.resolve(null)
                }
            } catch (e: Exception) {
                promise.reject("E_RELOAD_FAILED", e)
            }
        }
    }

    companion object {
        const val NAME = "CalorieWidget"
    }
}
