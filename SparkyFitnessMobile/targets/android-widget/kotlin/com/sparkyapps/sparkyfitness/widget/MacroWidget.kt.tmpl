/**
 * Height classes for the macro widget, derived from the actual layout budgets:
 *   SHORT  (< 170dp): macro rows only (inline label + value + progress). The
 *           kcal header, stacked rows and the action row need more height than
 *           the honest provider minimum (110dp), so at short heights the
 *           primary nutrition data wins and the secondary controls are omitted.
 *   NORMAL (170..250dp): header + inline/horizontal rows + both actions.
 *   TALL   (>= 250dp): header + stacked (narrow) or horizontal (wide) rows +
 *           actions with comfortable spacing.
 */
enum class MacroHeightClass { SHORT, NORMAL, TALL }

fun macroHeightClass(height: Dp): MacroHeightClass = when {
    height < 170.dp -> MacroHeightClass.SHORT
    height < 250.dp -> MacroHeightClass.NORMAL
    else -> MacroHeightClass.TALL
}

class MacroWidget : GlanceAppWidget() {

    override val stateDefinition = PreferencesGlanceStateDefinition

    /**
     * Exact size mode: the layout renders against the actual available size so
     * extra width/height from resizing is genuinely used. A fixed responsive
     * breakpoint set would still ignore size that falls between breakpoints —
     * exact mode is preferred here because launchers expose different grid
     * sizes across OEMs and the layout needs the real width AND height for long
     * localized labels such as Polish "Węglowodany".
     */
    override val sizeMode: SizeMode = SizeMode.Exact

    override suspend fun provideGlance(context: Context, id: GlanceId) {
        val fallbackSnapshot = loadSnapshot(context)
        provideContent {
            GlanceTheme {
                WidgetContent(context = context, fallbackSnapshot = fallbackSnapshot)
            }
        }
    }

    @Composable
    private fun WidgetContent(context: Context, fallbackSnapshot: MacroSnapshot?) {
        val state = currentState<Preferences>()
        val snapshot = parseSnapshot(state[SNAPSHOT_STATE_KEY]) ?: fallbackSnapshot

        // Widget-only locale override: localized string and number resolution
        // stay local to widget rendering (see WidgetLocale).
        val widgetContext = WidgetLocale.localizedContext(context)
        val size = LocalSize.current
        val wide = size.width >= 210.dp
        val heightClass = macroHeightClass(size.height)
        val short = heightClass == MacroHeightClass.SHORT
        // Stacked rows (label above value) need the most height; they are only
        // used on narrow + tall so "Węglowodany" gets its own line without
        // overflowing a short widget.
        val stacked = !wide && heightClass == MacroHeightClass.TALL
        // Inline row typography: compact at short/narrow-normal, richer on wide
        // or tall surfaces where there is room.
        val rowFontSize = when {
            stacked -> 13
            short -> 12
            wide && heightClass == MacroHeightClass.NORMAL -> 13
            else -> 14
        }
        val rowSpacing = if (heightClass == MacroHeightClass.TALL) 8 else 6

        val openAppIntent = Intent(Intent.ACTION_VIEW, Uri.parse("sparkyfitnessmobile://"))
            .setPackage(context.packageName)
        val searchIntent = Intent(Intent.ACTION_VIEW, Uri.parse("sparkyfitnessmobile://search"))
            .setPackage(context.packageName)
        val scanIntent = Intent(Intent.ACTION_VIEW, Uri.parse("sparkyfitnessmobile://scan"))
            .setPackage(context.packageName)
        val searchFoodLabel = widgetContext.getString(R.string.widget_search_food)
        val scanBarcodeLabel = widgetContext.getString(R.string.widget_scan_barcode)

        Box(
            modifier = GlanceModifier
                .fillMaxSize()
                .background(GlanceTheme.colors.surface)
                .appWidgetBackgroundCornerRadius()
                .padding(
                    horizontal = if (wide) 14.dp else 12.dp,
                    vertical = if (short) 10.dp else 12.dp,
                )
                .clickable(actionStartActivity(openAppIntent)),
            contentAlignment = Alignment.Center,
        ) {
            Column(modifier = GlanceModifier.fillMaxSize()) {
                if (heightClass == MacroHeightClass.TALL) {
                    Spacer(modifier = GlanceModifier.defaultWeight())
                }
                if (!short) {
                    CalorieHeader(context = widgetContext, snapshot = snapshot, compact = !wide)
                    Spacer(modifier = GlanceModifier.height(if (wide) 10.dp else 8.dp))
                }
                MacroRows(
                    context = widgetContext,
                    snapshot = snapshot,
                    spacing = rowSpacing,
                    stacked = stacked,
                    fontSize = rowFontSize,
                )
                Spacer(modifier = GlanceModifier.defaultWeight())
                if (!short) {
                    Spacer(modifier = GlanceModifier.height(if (wide) 14.dp else 10.dp))
                    Row(
                        modifier = GlanceModifier.fillMaxWidth(),
                        verticalAlignment = Alignment.CenterVertically,
                    ) {
                        ActionButton(
                            intent = searchIntent,
                            icon = R.drawable.ic_widget_search,
                            contentDescription = searchFoodLabel,
                            modifier = GlanceModifier
                                .defaultWeight()
                                .height(if (wide) 40.dp else 36.dp),
                        )
                        Box(
                            modifier = GlanceModifier
                                .width(1.dp)
                                .height(if (wide) 48.dp else 40.dp)
                                .background(GlanceTheme.colors.surfaceVariant),
                        ) {}
                        ActionButton(
                            intent = scanIntent,
                            icon = R.drawable.ic_widget_scan,
                            contentDescription = scanBarcodeLabel,
                            modifier = GlanceModifier
                                .defaultWeight()
                                .height(if (wide) 40.dp else 36.dp),
                        )
                    }
                }
            }
        }
    }

    @Composable
    private fun CalorieHeader(context: Context, snapshot: MacroSnapshot?, compact: Boolean) {
        val calories = snapshot?.displayCalories
        if (compact && snapshot?.hasData == true && calories != null) {
            // Compact contract: caption ("Pozostało") above the value so the
            // full phrase never disappears behind an ellipsis.
            Text(
                text = context.getString(R.string.widget_kcal_left_caption),
                style = TextStyle(
                    color = GlanceTheme.colors.onSurfaceVariant,
                    fontSize = 12.sp,
                    fontWeight = FontWeight.Medium,
                ),
                maxLines = 1,
                modifier = GlanceModifier.fillMaxWidth(),
            )
            Spacer(modifier = GlanceModifier.height(1.dp))
            Text(
                text = context.getString(
                    R.string.widget_kcal_left_value,
                    formatInt(context, calories),
                ),
                style = TextStyle(
                    color = GlanceTheme.colors.onSurface,
                    fontSize = 16.sp,
                    fontWeight = FontWeight.Bold,
                ),
                maxLines = 1,
                modifier = GlanceModifier.fillMaxWidth(),
            )
            return
        }
        val text = if (snapshot?.hasData == true && calories != null) {
            context.getString(R.string.widget_kcal_left, formatInt(context, calories))
        } else {
            context.getString(R.string.widget_kcal_left_empty)
        }
        Text(
            text = text,
            style = TextStyle(
                color = GlanceTheme.colors.onSurface,
                fontSize = if (compact) 15.sp else 20.sp,
                fontWeight = FontWeight.Bold,
            ),
            maxLines = 1,
            modifier = GlanceModifier.fillMaxWidth(),
        )
    }

    @Composable
    private fun MacroRows(
        context: Context,
        snapshot: MacroSnapshot?,
        spacing: Int,
        stacked: Boolean,
        fontSize: Int,
    ) {
        MacroRow(
            context = context,
            label = context.getString(R.string.widget_protein),
            grams = snapshot?.protein ?: 0.0,
            progress = snapshot.progressFor(MacroKind.PROTEIN),
            color = MacroPalette.protein,
            stacked = stacked,
            fontSize = fontSize,
        )
        Spacer(modifier = GlanceModifier.height(spacing.dp))
        MacroRow(
            context = context,
            label = context.getString(R.string.widget_carbs),
            grams = snapshot?.carbs ?: 0.0,
            progress = snapshot.progressFor(MacroKind.CARBS),
            color = MacroPalette.carbs,
            stacked = stacked,
            fontSize = fontSize,
        )
        Spacer(modifier = GlanceModifier.height(spacing.dp))
        MacroRow(
            context = context,
            label = context.getString(R.string.widget_fat),
            grams = snapshot?.fat ?: 0.0,
            progress = snapshot.progressFor(MacroKind.FAT),
            color = MacroPalette.fat,
            stacked = stacked,
            fontSize = fontSize,
        )
    }

    @Composable
    private fun MacroRow(
        context: Context,
        label: String,
        grams: Double,
        progress: Float,
        color: ColorProvider,
        stacked: Boolean,
        fontSize: Int,
    ) {
        Column(modifier = GlanceModifier.fillMaxWidth()) {
            if (stacked) {
                // Tall/narrow contract: the label gets its own line so
                // "Węglowodany" is never truncated to fit beside the value.
                Row(
                    modifier = GlanceModifier.fillMaxWidth(),
                    verticalAlignment = Alignment.CenterVertically,
                ) {
                    Box(
                        modifier = GlanceModifier
                            .size(10.dp)
                            .cornerRadius(5.dp)
                            .background(color),
                    ) {}
                    Spacer(modifier = GlanceModifier.width(6.dp))
                    Text(
                        text = label,
                        style = TextStyle(
                            color = GlanceTheme.colors.onSurfaceVariant,
                            fontSize = fontSize.sp,
                            fontWeight = FontWeight.Medium,
                        ),
                        maxLines = 1,
                        modifier = GlanceModifier.fillMaxWidth(),
                    )
                }
                Row(
                    modifier = GlanceModifier.fillMaxWidth(),
                    verticalAlignment = Alignment.CenterVertically,
                ) {
                    Spacer(modifier = GlanceModifier.width(16.dp))
                    Text(
                        text = context.getString(R.string.widget_grams, formatInt(context, grams)),
                        style = TextStyle(
                            color = GlanceTheme.colors.onSurface,
                            fontSize = fontSize.sp,
                            fontWeight = FontWeight.Medium,
                        ),
                        maxLines = 1,
                    )
                    Spacer(modifier = GlanceModifier.defaultWeight())
                }
            } else {
                // Inline row (label left, value right): compact enough for
                // short heights while keeping the full label, including
                // "Węglowodany", visible on one line.
                Row(
                    modifier = GlanceModifier.fillMaxWidth(),
                    verticalAlignment = Alignment.CenterVertically,
                ) {
                    Box(
                        modifier = GlanceModifier
                            .size(if (fontSize >= 14) 12.dp else 8.dp)
                            .cornerRadius(if (fontSize >= 14) 6.dp else 4.dp)
                            .background(color),
                    ) {}
                    Spacer(modifier = GlanceModifier.width(if (fontSize >= 14) 8.dp else 6.dp))
                    Text(
                        text = label,
                        style = TextStyle(
                            color = GlanceTheme.colors.onSurfaceVariant,
                            fontSize = fontSize.sp,
                            fontWeight = FontWeight.Medium,
                        ),
                        maxLines = 1,
                        modifier = GlanceModifier.defaultWeight(),
                    )
                    Spacer(modifier = GlanceModifier.width(6.dp))
                    Text(
                        text = context.getString(R.string.widget_grams, formatInt(context, grams)),
                        style = TextStyle(
                            color = GlanceTheme.colors.onSurface,
                            fontSize = fontSize.sp,
                            fontWeight = FontWeight.Medium,
                        ),
                        maxLines = 1,
                    )
                }
            }
            Spacer(modifier = GlanceModifier.height(if (stacked) 3.dp else 2.dp))
            LinearProgressIndicator(
                progress = progress,
                modifier = GlanceModifier
                    .fillMaxWidth()
                    .height(if (stacked) 3.dp else (if (fontSize >= 14) 4.dp else 3.dp)),
                color = color,
                backgroundColor = GlanceTheme.colors.surfaceVariant,
            )
        }
    }

    @Composable
    private fun ActionButton(
        intent: Intent,
        icon: Int,
        contentDescription: String,
        modifier: GlanceModifier = GlanceModifier
            .fillMaxWidth()
            .height(42.dp),
    ) {
        Box(
            modifier = modifier.clickable(actionStartActivity(intent)),
            contentAlignment = Alignment.Center,
        ) {
            Image(
                provider = ImageProvider(icon),
                contentDescription = contentDescription,
                colorFilter = ColorFilter.tint(GlanceTheme.colors.primary),
                modifier = GlanceModifier.size(24.dp),
            )
        }
    }

    private data class MacroSnapshot(
        val date: String,
        val protein: Double,
        val carbs: Double,
        val fat: Double,
        val calories: Double,
        val remaining: Double?,
        val lastUpdated: Long,
    ) {
        val proteinKcal: Double = protein * 4.0
        val carbsKcal: Double = carbs * 4.0
        val fatKcal: Double = fat * 9.0
        val macroKcalTotal: Double = proteinKcal + carbsKcal + fatKcal
        val displayCalories: Double? = remaining ?: calories
        val hasData: Boolean =
            macroKcalTotal > 0.0 || (displayCalories ?: 0.0) > 0.0
    }

    private enum class MacroKind {
        PROTEIN,
        CARBS,
        FAT,
    }

    private fun loadSnapshot(context: Context): MacroSnapshot? {
        val prefs = context.getSharedPreferences(
            MacroWidgetReceiver.PREFS_NAME,
            Context.MODE_PRIVATE,
        )
        return parseSnapshot(prefs.getString(MacroWidgetReceiver.PREFS_KEY_SNAPSHOT, null))
    }

    private fun parseSnapshot(json: String?): MacroSnapshot? {
        if (json == null) return null
        return try {
            val obj = JSONObject(json)
            val date = obj.optString("date", "")
            if (!isToday(date)) return null
            MacroSnapshot(
                date = date,
                protein = obj.safeDouble("protein"),
                carbs = obj.safeDouble("carbs"),
                fat = obj.safeDouble("fat"),
                calories = obj.safeDouble("calories"),
                remaining = if (obj.has("remaining")) {
                    obj.safeDouble("remaining")
                } else {
                    null
                },
                lastUpdated = obj.optLong("lastUpdated", 0L),
            )
        } catch (e: Exception) {
            null
        }
    }

    private fun MacroSnapshot?.progressFor(kind: MacroKind): Float {
        val snapshot = this ?: return 0f
        val total = snapshot.macroKcalTotal
        if (total <= 0.0) return 0f

        val value = when (kind) {
            MacroKind.PROTEIN -> snapshot.proteinKcal
            MacroKind.CARBS -> snapshot.carbsKcal
            MacroKind.FAT -> snapshot.fatKcal
        }
        return (value / total).coerceIn(0.0, 1.0).toFloat()
    }

    private fun JSONObject.safeDouble(name: String): Double {
        val value = optDouble(name, 0.0)
        return if (value.isFinite()) value else 0.0
    }

    private fun isToday(date: String): Boolean {
        if (date.isBlank()) return false
        return try {
            val parsed = LocalDate.parse(date, DateTimeFormatter.ISO_LOCAL_DATE)
            parsed == LocalDate.now()
        } catch (e: Exception) {
            false
        }
    }

    private fun formatInt(context: Context, value: Double): String {
        return formatWidgetInt(context, value)
    }

    companion object {
        val SNAPSHOT_STATE_KEY = stringPreferencesKey(MacroWidgetReceiver.PREFS_KEY_SNAPSHOT)
    }
}

private object MacroPalette {
    val protein = ColorProvider(Color(0xFFF6B151))
    val carbs = ColorProvider(Color(0xFF7BD680))
    val fat = ColorProvider(Color(0xFF6DCBE9))
}
