<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <service
      android:name="expo.modules.watchconnectivity.SparkyWearListenerService"
      android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <data android:scheme="wear" android:host="*" android:pathPrefix="/sparky" />
      </intent-filter>
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
        <data android:scheme="wear" android:host="*" android:pathPrefix="/sparky/transfer/watch" />
      </intent-filter>
    </service>
    <service
      android:name="expo.modules.watchconnectivity.SparkyMediaListenerService"
      android:exported="true"
      android:label="SparkyFitness Media Controls"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
      <meta-data
        android:name="android.service.notification.default_filter_types"
        android:value="ongoing" />
      <meta-data
        android:name="android.service.notification.disabled_filter_types"
        android:value="conversations|alerting|silent" />
    </service>
  </application>
</manifest>
