{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "App.tsx",
    "index.js",
    "plugins/**/*.ts",
    "__tests__/**/*.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}", "App.tsx"],
  "rules": {
    "exports": "error",
    "types": "off",
    "files": "off",
    "dependencies": "off",
    "unlisted": "off",
    "binaries": "off",
    "unresolved": "off",
    "duplicates": "off"
  },
  "ignoreExportsUsedInFile": true
}
