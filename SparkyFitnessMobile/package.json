{
  "name": "sparkyfitnessmobile",
  "version": "1.8.0",
  "private": true,
  "expo": {
    "autolinking": {
      "exclude": [
        "@expo/dom-webview"
      ]
    }
  },
  "scripts": {
    "set-version": "pnpm -w run set-version",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "watch": "node scripts/run-watch.mjs",
    "watch:device": "xcodebuild -workspace ios/SparkyFitness.xcworkspace -scheme 'SparkyFitnessWatch' -destination 'generic/platform=watchOS' build",
    "knip": "knip",
    "i18n:audit": "node scripts/audit-mobile-i18n.mjs",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint src App.tsx index.js __tests__ --max-warnings 0",
    "lint:compiler": "eslint --no-config-lookup --config eslint.compiler.config.js src App.tsx",
    "start": "expo start",
    "test": "jest",
    "test:run": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write --log-level warn",
    "format:check": "prettier . --check",
    "validate": "pnpm run i18n:generate:check && pnpm run muscle-figure:generate:check && pnpm run typecheck && pnpm run lint && pnpm run i18n:audit && pnpm run knip && pnpm run native-locales:check && pnpm run format:check",
    "i18n:generate": "node scripts/generate-locale-resources.mjs",
    "i18n:generate:check": "node scripts/generate-locale-resources.mjs --check",
    "muscle-figure:generate": "node scripts/generate-muscle-figure.mjs",
    "muscle-figure:generate:check": "node scripts/generate-muscle-figure.mjs --check",
    "native-locales:check": "node scripts/validate-native-widget-locales.mjs"
  },
  "dependencies": {
    "@assistant-ui/react-ai-sdk": "^1.4.10",
    "@assistant-ui/react-native": "^0.1.41",
    "@bacons/apple-targets": "^4.0.6",
    "@better-auth/expo": "1.7.4",
    "@better-auth/sso": "1.7.4",
    "@bottom-tabs/react-navigation": "^1.4.0",
    "@expo/ui": "~57.0.20",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@kingstinct/react-native-healthkit": "^15.1.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.102.8",
    "@workspace/shared": "workspace:*",
    "better-auth": "1.7.4",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-background-task": "~57.0.20",
    "expo-build-properties": "^57.0.22",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "^57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-navigation-bar": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.20",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.21",
    "i18next": "26.4.2",
    "ipaddr.js": "^2.5.0",
    "react": "19.2.3",
    "react-i18next": "17.0.13",
    "react-native": "0.86.3",
    "react-native-bottom-tabs": "^1.4.0",
    "react-native-enriched-markdown": "1.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-maps": "1.27.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.5.2",
    "react-native-ui-datepicker": "^3.3.0",
    "react-native-worklets": "0.10.1",
    "remend": "1.3.1",
    "tailwindcss": "^4.1.18",
    "uniwind": "^1.12.0",
    "victory-native": "^42.0.1",
    "zod": "^4.6.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "babel-jest": "~29.7.0",
    "babel-preset-expo": "~57.0.11",
    "eslint": "^9.39.3",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "expo-atlas": "^0.4.0",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-expo": "~57.0.5",
    "knip": "^6.35.1",
    "prettier": "3.9.6",
    "radon-ide": "^0.0.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "__tests__/helpers/",
      "__tests__/hooks/queryTestUtils\\.ts$",
      "__tests__/screens/helpers/",
      "__tests__/config/helpers/"
    ],
    "moduleNameMapper": {
      "^@workspace/shared$": "<rootDir>/../shared/src/index.ts",
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1",
      "^remend$": "<rootDir>/node_modules/remend/dist/index.js",
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^expo/src/winter$": "<rootDir>/__mocks__/expo-winter.js"
    },
    "transform": {
      "^.+\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ],
          "babelrc": false,
          "configFile": false
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo[^/]*|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@shopify/react-native-skia|react-native-ui-datepicker|@workspace/shared|remend|zod|better-auth|@better-auth/.*|@better-fetch/.*|nanostores|jose|@noble/.*|better-call|defu)/)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/metro.config.js",
      "!**/eslint.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**",
      "!**/devdocs/**"
    ]
  }
}
