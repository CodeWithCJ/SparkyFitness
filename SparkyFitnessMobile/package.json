{
  "name": "sparkyfitnessmobile",
  "version": "1.12.1",
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-keyboard-controller",
        "react-native-pager-view",
        "react-native-svg"
      ]
    },
    "autolinking": {
      "exclude": [
        "@expo/dom-webview"
      ],
      "android": {
        "buildFromSource": [
          "expo-camera"
        ]
      }
    }
  },
  "scripts": {
    "set-version": "pnpm -w run set-version",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "android:release": "expo run:android --variant release --device",
    "android:release:clean": "expo prebuild --platform android --clean && expo run:android --variant release --device",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release --device",
    "ios:release:clean": "expo prebuild --platform ios --clean && expo run:ios --configuration Release --device",
    "ios:device": "expo run:ios --device",
    "watch": "node scripts/run-watch.mjs",
    "watch:device": "xcodebuild -workspace ios/SparkyFitness.xcworkspace -scheme 'SparkyFitnessWatch' -destination 'generic/platform=watchOS' build",
    "knip": "knip",
    "i18n:audit": "node scripts/audit-mobile-i18n.mjs",
    "i18n:audit:watch": "node scripts/audit-watch-i18n.mjs",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint src App.tsx index.js __tests__ --max-warnings 0",
    "lint:compiler": "eslint --no-config-lookup --config eslint.compiler.config.js src App.tsx",
    "start": "expo start",
    "test": "jest",
    "test:run": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "typecheck": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc --noEmit",
    "format": "prettier . --write --log-level warn",
    "format:check": "prettier . --check",
    "validate": "pnpm run i18n:generate:check && pnpm run muscle-figure:generate:check && pnpm run typecheck && pnpm run lint && pnpm run i18n:audit && pnpm run i18n:audit:watch && pnpm run knip && pnpm run native-locales:check && pnpm run format:check",
    "i18n:generate": "node scripts/generate-locale-resources.mjs",
    "i18n:generate:check": "node scripts/generate-locale-resources.mjs --check",
    "muscle-figure:generate": "node scripts/generate-muscle-figure.mjs",
    "muscle-figure:generate:check": "node scripts/generate-muscle-figure.mjs --check",
    "native-locales:check": "node scripts/validate-native-widget-locales.mjs"
  },
  "dependencies": {
    "@assistant-ui/react-ai-sdk": "^1.4.24",
    "@assistant-ui/react-native": "^0.1.52",
    "@bacons/apple-targets": "^4.0.6",
    "@better-auth/expo": "1.7.27",
    "@better-auth/sso": "1.7.27",
    "@bottom-tabs/react-navigation": "^1.5.0",
    "@expo/ui": "~58.0.29",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@kingstinct/react-native-healthkit": "^16.2.0",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.0",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.108.2",
    "@workspace/shared": "workspace:*",
    "better-auth": "1.7.27",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-background-task": "~58.0.13",
    "expo-build-properties": "^58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "^58.0.21",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-quick-actions": "~6.0.2",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-web-browser": "~58.1.0",
    "expo-widgets": "~58.0.29",
    "i18next": "27.2.3",
    "ipaddr.js": "^2.5.0",
    "react": "19.3.0",
    "react-i18next": "18.0.3",
    "react-native": "0.88.1",
    "react-native-bottom-tabs": "^1.5.0",
    "react-native-enriched-markdown": "1.2.0",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-keyboard-controller": "1.23.1",
    "react-native-maps": "1.29.11",
    "react-native-nfc-manager": "4.3.0",
    "react-native-nitro-modules": "0.37.2",
    "react-native-pager-view": "10.0.3",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-toast-message": "^2.5.2",
    "react-native-ui-datepicker": "^3.3.0",
    "react-native-worklets": "0.13.0",
    "remend": "1.5.0",
    "tailwindcss": "^4.1.18",
    "uniwind": "^1.14.0",
    "victory-native": "^42.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/runtime": "^7.25.0",
    "@expo/dom-webview": "~58.0.2",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "~30.5.2",
    "babel-preset-expo": "~58.0.26",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "~30.5.2",
    "jest-expo": "~58.0.15",
    "knip": "^6.47.0",
    "prettier": "3.10.1",
    "radon-ide": "^0.0.1",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "workerIdleMemoryLimit": "1.5GB",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "__tests__/helpers/",
      "__tests__/hooks/queryTestUtils\\.ts$",
      "__tests__/screens/helpers/",
      "__tests__/config/helpers/"
    ],
    "moduleNameMapper": {
      "^@workspace/shared$": "<rootDir>/../shared/src/index.ts",
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1",
      "^remend$": "<rootDir>/node_modules/remend/dist/index.js",
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^expo/src/winter$": "<rootDir>/__mocks__/expo-winter.js"
    },
    "transform": {
      "^.+\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ],
          "babelrc": false,
          "configFile": false
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo[^/]*|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@shopify/react-native-skia|react-native-ui-datepicker|@workspace/shared|remend|zod|better-auth|@better-auth/.*|@better-fetch/.*|nanostores|jose|@noble/.*|better-call|defu)/)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/metro.config.js",
      "!**/eslint.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**",
      "!**/devdocs/**"
    ]
  }
}
