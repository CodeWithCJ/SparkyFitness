# =================================================================
# SparkyFitness - Minimal Environment Configuration (.env)
# Five values are all a standard Docker Compose install needs.
# Interactive Generator: https://codewithcj.github.io/SparkyFitness/install/env-generator
# =================================================================

# 1. PostgreSQL Superuser
# The database name and the application user have working defaults
# (sparkyfitness_db, sparky_app), and the server creates and maintains the
# application role itself.
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_DB_PASSWORD=changeme_db_password

# 2. Cryptographic Security Keys
# Generate with: openssl rand -hex 32
SPARKY_FITNESS_API_ENCRYPTION_KEY=replace_with_a_64_character_hex_string
BETTER_AUTH_SECRET=replace_with_a_strong_better_auth_secret

# 3. Access URL
# Storage paths are intentionally omitted: docker-compose writes the database,
# backups and uploads next to your docker-compose.yml by default. Set DB_PATH,
# SERVER_BACKUP_PATH and SERVER_UPLOADS_PATH only to move them elsewhere.
# e.g., http://localhost:3004, http://192.168.1.100:3004, or https://fitness.yourdomain.com
SPARKY_FITNESS_FRONTEND_URL=http://localhost:3004
