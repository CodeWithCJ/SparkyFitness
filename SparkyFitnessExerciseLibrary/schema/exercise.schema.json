{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SparkyFitnessExercise",
  "description": "Canonical schema for an individual SparkyFitness exercise definition",
  "type": "object",
  "required": [
    "id",
    "name",
    "taxonomy",
    "biomechanics",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "description": "Unique canonical identifier matching folder name (e.g., '00001_3_4_sit_up', '00025_barbell_bench_press')",
      "pattern": "^[0-9]{5}_[a-z0-9_]+$"
    },
    "numeric_id": {
      "type": "string",
      "description": "Zero-padded 5-digit sequential identifier (e.g., '00001', '00025')",
      "pattern": "^[0-9]{5}$"
    },
    "slug": {
      "type": "string",
      "description": "Clean URL/text slug without numeric prefix (e.g., '3_4_sit_up', 'barbell_bench_press')",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "description": "Canonical English display name of the exercise",
      "minLength": 2
    },
    "description": {
      "type": ["string", "null"],
      "description": "Optional one-line summary or overview of the exercise"
    },
    "calories_per_hour": {
      "type": ["number", "null"],
      "description": "Estimated calorie burn per hour (primarily for cardio or endurance exercises)"
    },
    "aliases": {
      "type": "array",
      "description": "Alternative names or search synonyms",
      "items": {
        "type": "string"
      }
    },
    "taxonomy": {
      "type": "object",
      "required": [
        "modality",
        "category",
        "body_part",
        "equipment",
        "primary_muscles"
      ],
      "additionalProperties": false,
      "properties": {
        "modality": {
          "type": "string",
          "enum": [
            "weight_reps",
            "reps_only",
            "bodyweight_reps",
            "weight_duration",
            "weight_distance",
            "duration",
            "duration_distance"
          ],
          "description": "Modal input type matching SparkyFitness EXERCISE_MODALITIES"
        },
        "category": {
          "type": "string",
          "description": "Target body area or exercise category (e.g. chest, back, waist, arms, legs, cardio)"
        },
        "body_part": {
          "type": "string",
          "description": "Anatomical region (e.g. chest, upper arms, waist, thighs)"
        },
        "mechanic": {
          "type": ["string", "null"],
          "enum": ["compound", "isolation", null],
          "description": "Multi-joint compound or single-joint isolation"
        },
        "force": {
          "type": ["string", "null"],
          "enum": ["push", "pull", "static", null],
          "description": "Direction of force applied"
        },
        "level": {
          "type": ["string", "null"],
          "enum": ["beginner", "intermediate", "expert", null],
          "description": "Experience level required"
        },
        "equipment": {
          "type": "string",
          "enum": [
            "barbell",
            "dumbbell",
            "kettlebells",
            "cable",
            "machine",
            "bands",
            "body only",
            "medicine ball",
            "exercise ball",
            "foam roll",
            "e-z curl bar",
            "other"
          ],
          "description": "Required equipment matching SparkyFitness CANONICAL_EQUIPMENT"
        },
        "primary_muscles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "abdominals",
              "abductors",
              "adductors",
              "biceps",
              "calves",
              "chest",
              "forearms",
              "glutes",
              "hamstrings",
              "lats",
              "lower back",
              "middle back",
              "neck",
              "quadriceps",
              "shoulders",
              "traps",
              "triceps"
            ]
          },
          "description": "Primary muscles targeted, matching SparkyFitness CANONICAL_MUSCLES"
        },
        "secondary_muscles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "abdominals",
              "abductors",
              "adductors",
              "biceps",
              "calves",
              "chest",
              "forearms",
              "glutes",
              "hamstrings",
              "lats",
              "lower back",
              "middle back",
              "neck",
              "quadriceps",
              "shoulders",
              "traps",
              "triceps"
            ]
          },
          "description": "Synergist or assisting muscles"
        }
      }
    },
    "biomechanics": {
      "type": "object",
      "required": ["laterality"],
      "additionalProperties": false,
      "properties": {
        "laterality": {
          "type": "string",
          "enum": [
            "bilateral",
            "unilateral_left",
            "unilateral_right",
            "alternating"
          ]
        },
        "movement_plane": {
          "type": "string",
          "enum": ["sagittal", "frontal", "transverse", "multiplanar"]
        },
        "default_tempo": {
          "type": "string",
          "description": "Default tempo notation (eccentric-pause-concentric-pause, e.g. '2-0-2-0')"
        },
        "demonstration_reps": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of complete movement cycles shown in the demonstration video"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "video_path": {
          "type": "string",
          "description": "Relative path to default MP4 video demonstration"
        },
        "video_vertical_path": {
          "type": "string",
          "description": "Relative path to vertical 9:16 MP4 video demonstration (ideal for mobile full-screen / portrait tutorial)"
        },
        "video_horizontal_path": {
          "type": "string",
          "description": "Relative path to horizontal 16:9 MP4 video demonstration (ideal for web, desktop, landscape, and compact logger)"
        },
        "animation_path": {
          "type": "string",
          "description": "Relative path to looping preview animation (Animated WebP or GIF)"
        },
        "animation_vertical_path": {
          "type": "string",
          "description": "Relative path to vertical 9:16 looping preview animation (Animated WebP or GIF)"
        },
        "animation_horizontal_path": {
          "type": "string",
          "description": "Relative path to horizontal 16:9 looping preview animation (Animated WebP or GIF)"
        },
        "gif_path": {
          "type": "string",
          "description": "Legacy fallback path to looping preview animated GIF"
        },
        "thumbnail_path": {
          "type": "string",
          "description": "Relative path to card thumbnail image (WebP or JPG)"
        },
        "thumbnail_timestamp": {
          "type": "number",
          "minimum": 0,
          "description": "Optional timestamp in seconds to extract the defining action thumbnail frame"
        },
        "image_path": {
          "type": "string",
          "description": "Optional fallback static diagram for exercises without video"
        }
      }
    },
    "steps": {
      "type": "array",
      "description": "Ordered sequence of action steps in English. Used as canonical source of truth for translations in Weblate.",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "coaching_cues": {
      "type": "array",
      "description": "Short bullet points highlighting common form errors, breathing cues, or posture tips",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "external_id": { "type": "string" },
        "attribution": { "type": "string" }
      }
    }
  }
}
