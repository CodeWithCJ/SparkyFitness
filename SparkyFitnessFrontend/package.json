{
  "name": "sparkyfitnessfrontend",
  "private": true,
  "version": "1.8.0",
  "homepage": "https://github.com/CodeWithCJ/SparkyFitness",
  "type": "module",
  "scripts": {
    "set-version": "pnpm -w run set-version",
    "dev": "vite",
    "knip": "knip",
    "typecheck": "tsc -b",
    "format:check": "prettier . --check",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run knip",
    "build": "pnpm run validate && vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "jest",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "format": "prettier . --write --log-level warn"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setupTests.ts"
    ],
    "moduleNameMapper": {
      "\\.(css|less|sass|scss)$": "identity-obj-proxy",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@workspace/shared$": "<rootDir>/../shared/src/index.ts",
      "^@workspace/shared/(.*)$": "<rootDir>/../shared/src/$1",
      "^better-auth$": "<rootDir>/src/tests/stubs/betterAuth.ts",
      "^better-auth/(.*)$": "<rootDir>/src/tests/stubs/betterAuth.ts",
      "^@better-auth/(.*)$": "<rootDir>/src/tests/stubs/betterAuth.ts",
      "^react-markdown$": "<rootDir>/src/tests/stubs/reactMarkdown.tsx",
      "^remark-gfm$": "<rootDir>/src/tests/stubs/remarkGfm.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "jsx": "react-jsx",
            "esModuleInterop": true,
            "module": "ESNext",
            "moduleResolution": "bundler",
            "rootDir": ".",
            "types": [
              "jest",
              "@testing-library/jest-dom",
              "node"
            ],
            "isolatedModules": true
          }
        }
      ],
      "^.+\\.jsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "allowJs": true,
            "esModuleInterop": true,
            "module": "ESNext",
            "moduleResolution": "bundler",
            "rootDir": ".",
            "isolatedModules": true
          }
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts",
      ".tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?@tanstack/)"
    ]
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.102",
    "@assistant-ui/react": "^0.15.19",
    "@assistant-ui/react-ai-sdk": "^1.4.10",
    "@assistant-ui/react-markdown": "^0.14.15",
    "@better-auth/api-key": "^1.7.4",
    "@better-auth/passkey": "^1.7.4",
    "@better-auth/sso": "^1.7.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ericblade/quagga2": "^1.12.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@types/leaflet": "1.9.16",
    "@workspace/shared": "workspace:*",
    "@zxing/library": "^0.23.0",
    "ai": "^7.0.99",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-grid-layout": "^2.2.4",
    "react-i18next": "^17.0.13",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.3",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-shimmer": "^0.4.12",
    "uuid": "^14.0.2",
    "zod": "^4.6.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "knip": "^6.35.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-react-click-to-component": "^4.2.3"
  }
}
