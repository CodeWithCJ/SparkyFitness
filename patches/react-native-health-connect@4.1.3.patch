+/**
+ * SparkyFitness patch: reads a written record's zone offset ({ totalSeconds })
+ * so it is stored, instead of every write dropping it.
+ */
+fun getZoneOffsetFromJsMap(map: ReadableMap?): ZoneOffset? {
+  if (map == null || !map.hasKey("totalSeconds")) {
+    return null
+  }
+  return ZoneOffset.ofTotalSeconds(map.getInt("totalSeconds"))
