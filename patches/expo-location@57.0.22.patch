+  private fun startFrameworkLocationUpdates(context: Context, locationRequest: LocationRequest, intent: PendingIntent) {
+    val manager = FrameworkLocation.manager(context) ?: run {
+      Log.w(TAG, "LocationManager is not available")
+      return
+    }
+    val provider = FrameworkLocation.bestProvider(manager) ?: run {
+      Log.w(TAG, "There is no enabled location provider")
+      return
+    }
+    try {
+      manager.requestLocationUpdates(
+        provider,
+        locationRequest.intervalMillis,
+        locationRequest.minUpdateDistanceMeters,
+        intent
+      )
+      Log.i(TAG, "Location updates use the $provider provider (no Google Play Services)")
+    } catch (e: SecurityException) {
+      Log.w(TAG, "Location request has been rejected.", e)
+    } catch (e: IllegalArgumentException) {
+      Log.w(TAG, "Location request failed for the $provider provider.", e)
+    }
+  }
