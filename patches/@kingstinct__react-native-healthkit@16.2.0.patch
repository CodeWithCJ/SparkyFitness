+/// SparkyFitness patch: puts the sync keys under Apple's constants whatever
+/// spelling JS used, and makes the sync version an integer.
+private func normalizeSyncMetadata(_ metadata: [String: Any]?) -> [String: Any]? {
+  guard var result = metadata else { return nil }
+  for alias in ["HKMetadataKeySyncIdentifier", "HKSyncIdentifier"] {
+    if let value = result.removeValue(forKey: alias) {
+      result[HKMetadataKeySyncIdentifier] = value
+    }
+  }
+  for alias in ["HKMetadataKeySyncVersion", "HKSyncVersion"] {
+    if let value = result.removeValue(forKey: alias) {
+      if let number = value as? NSNumber {
+        result[HKMetadataKeySyncVersion] = NSNumber(value: number.int64Value)
+      } else {
+        result[HKMetadataKeySyncVersion] = value
+      }
+    }
+  }
+  return result
+}
